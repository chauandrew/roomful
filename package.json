{
  "name": "roomful",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "run-p dev:next dev:party",
    "dev:next": "next dev",
    "dev:party": "wrangler dev --port 1999",
    "build": "next build",
    "start": "next start",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:fruit-ninja": "tsx --test lib/fruit-ninja/*.test.ts",
    "test:crossy-beach": "tsx --test games/crossy-beach/*.test.ts",
    "test:flappy-human": "tsx --test games/flappy-human/*.test.ts",
    "test:reflex-runner": "tsx --test games/reflex-runner/*.test.ts",
    "replay:flappy-human": "tsx games/flappy-human/replay-recording.ts",
    "deploy:party": "wrangler deploy"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.2.12",
    "partyserver": "^0.5.9",
    "partysocket": "^1.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-qr-code": "^2.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "postcss": "8.5.24"
  }
}
